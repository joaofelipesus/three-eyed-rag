<div class="chat-container">
  <div id="chat_messages" class="chat-messages"></div>

  <%= form_with url: chat_notes_path, method: :post, class: "chat-form",
        data: { controller: "chat", action: "turbo:submit-start->chat#start turbo:submit-end->chat#end" } do |form| %>
    <%= form.text_field :query, placeholder: "Ask something about your notes...", class: "chat-input", autocomplete: "off", required: true, minlength: 3, autofocus: true, data: { chat_target: "input" } %>
    <%= form.submit "Send", class: "chat-submit", data: { chat_target: "submit" } %>
  <% end %>
</div>
